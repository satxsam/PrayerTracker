# Database Configuration
# Default is SQLite, but you can use PostgreSQL, MySQL, etc.
# DATABASE_URL=sqlite:///./prayer_tracker.db
# DATABASE_URL=postgresql://user:password@localhost/prayer_tracker
# DATABASE_URL=mysql://user:password@localhost/prayer_tracker

# CORS Configuration
# Comma-separated list of allowed origins
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.com

# Server Configuration
# PORT=8000
